[Unit]
Description=AbuseGuard: refresh threat-intel blocklist and apply native policy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The sync process itself stays unprivileged; the root oneshot helper below is
# the only part that needs CAP_NET_ADMIN and writes root-owned snapshots.
ExecStart=/usr/sbin/runuser -u abuseguard -- /usr/local/libexec/caddy-abuseguard sync-intel
ExecStartPost=/usr/local/libexec/caddy-abuseguard-policy apply

# --- sandboxing --------------------------------------------------------------
# runuser needs setuid/setgid; the root applier needs CAP_NET_ADMIN and writes
# root-owned snapshots. Everything else is read-only.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/caddy-abuseguard /var/lib/caddy-abuseguard /etc/fail2ban/jail.d /run/fail2ban
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=setuid setgid setgroups setresuid setresgid
SystemCallErrorNumber=EPERM
