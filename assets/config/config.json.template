{
  "allowlist_file": "/etc/caddy-abuseguard/whitelist",
  "paths": {
    "state_dir": "/var/lib/caddy-abuseguard",
    "reports_dir": "/var/lib/caddy-abuseguard/reports"
  },
  "intel": {
