# AbuseGuard jails for Caddy.
#
# All jails read the same privacy-trimmed Caddy access log and block with
# nftables (drop) on every port and protocol.
#
# Whitelist handling is native: /etc/caddy-abuseguard/whitelist is exported by
# the engine and written as `ignoreip` into
# /etc/fail2ban/jail.d/zzz-caddy-abuseguard-policy.local by
# `caddy-abuseguard-policy apply` (Ag panel / install / six-hour sync). There is
# no per-request ignorecommand and no intel-only jail: the kernel intel set
# decides feed enforcement, and these jails enforce behaviour only.
#
# Manual bans from the panel land in caddy-rate-local (drop-only, no report).

[caddy-rate-local]
enabled       = true
backend       = auto
usedns        = no
bantime       = 90d
filter        = caddy-abuseguard-any
logpath       = /var/log/caddy/abuseguard-access.json
datepattern   = "ts":{EPOCH}
# 120 req / 60s: leaves headroom for a real visitor's first page load (static
# assets, SPA bundles, XHR bursts) while still catching obvious flooding.
maxretry      = 120
findtime      = 60s
action        = caddy-abuseguard-drop

[caddy-probe-h1]
enabled       = true
backend       = auto
usedns        = no
bantime       = 90d
filter        = caddy-abuseguard-probe-h1
logpath       = /var/log/caddy/abuseguard-access.json
datepattern   = "ts":{EPOCH}
maxretry      = 5
findtime      = 10m
action        = caddy-abuseguard-drop
                caddy-abuseguard-queue[profile=web-probe, transport=HTTP/1.1, target_port=443, window=10m]

[caddy-probe-h2]
enabled       = true
backend       = auto
usedns        = no
bantime       = 90d
filter        = caddy-abuseguard-probe-h2
logpath       = /var/log/caddy/abuseguard-access.json
datepattern   = "ts":{EPOCH}
maxretry      = 5
findtime      = 10m
action        = caddy-abuseguard-drop
                caddy-abuseguard-queue[profile=web-probe, transport=HTTP/2.0, target_port=443, window=10m]
