# Enable SSH protection on install. Keep the system's SSH log/backend and
# detection thresholds; the kernel intel set and generated `ignoreip` handle
# feed/allowlist enforcement, and this jail enforces behaviour only.
# The installer rewrites target_port below to the port sshd actually listens on.
[sshd]
enabled = true
bantime = 90d
action = caddy-abuseguard-drop
         caddy-abuseguard-queue[profile=ssh-bruteforce, transport=SSH, target_port=22, window="%(findtime)s"]
